# Set secrets only in your local .env file. Never commit real values.
AI_COMPANY_PROFILE=lite
AI_COMPANY_DATA_DIR=
AI_COMPANY_LITE_CONCURRENCY=2
# Standard profile only:
DATABASE_URL=
RABBITMQ_URL=
ARTIFACT_ROOT=
# Real AI stays fail-closed until this is changed to true and setup is approved.
AI_COMPANY_REAL_AI_ENABLED=false
# This release deliberately routes every story role to GPT-5.6-Terra only.
AI_COMPANY_STORY_ARCHITECT_PROVIDER=openai
AI_COMPANY_STORY_ARCHITECT_FALLBACKS=
# Leave these blank to inherit the Story Architect route.
AI_COMPANY_CHAPTER_WRITER_PROVIDER=
AI_COMPANY_CHAPTER_WRITER_FALLBACKS=
AI_COMPANY_EDITOR_PROVIDER=
AI_COMPANY_EDITOR_FALLBACKS=
AI_COMPANY_CONTINUITY_QC_PROVIDER=
AI_COMPANY_CONTINUITY_QC_FALLBACKS=
# Secret values intentionally stay blank in this tracked example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
AI_COMPANY_POLICY_VERSION=story-agents-policy-v2-terra-only
AI_COMPANY_ASSIGNMENT_VERSION=story-agents-models-v2-terra-only
AI_COMPANY_BUDGET_VERSION=story-agents-budget-v2-terra-only
# Minor currency units: 100 means USD 1.00 when currency is USD.
# Starter cap USD 5.00; raise only after measuring actual cost/story.
AI_COMPANY_DAILY_BUDGET_MINOR=500
AI_COMPANY_BUDGET_CURRENCY=USD
# Copy current per-million-token prices in minor units from the official provider pricing page.
AI_COMPANY_OPENAI_RATE_CARD_VERSION=gpt-5.6-terra-standard-2026-10-10
AI_COMPANY_OPENAI_INPUT_MINOR_PER_MILLION=200
AI_COMPANY_OPENAI_OUTPUT_MINOR_PER_MILLION=1200
AI_COMPANY_OPENAI_MAX_OUTPUT_TOKENS=6000
AI_COMPANY_OPENAI_TIMEOUT_SECONDS=60
AI_COMPANY_OPENAI_SERVICE_TIER=default
# fast = one model call/chapter; quality = independent writer/editor/QC calls.
AI_COMPANY_CHAPTER_PIPELINE_MODE=fast
AI_COMPANY_STORY_ARCHITECT_REASONING_EFFORT=low
AI_COMPANY_CHAPTER_WRITER_REASONING_EFFORT=none
AI_COMPANY_EDITOR_REASONING_EFFORT=none
AI_COMPANY_CONTINUITY_QC_REASONING_EFFORT=low

# Optional localhost-only MuMuAINovel bridge.
MUMUAINOVEL_BASE_URL=http://127.0.0.1:8800
MUMUAINOVEL_USERNAME=
MUMUAINOVEL_PASSWORD=
