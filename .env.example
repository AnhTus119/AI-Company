# Set secrets only in your local .env file. Never commit real values.
AI_COMPANY_PROFILE=lite
AI_COMPANY_DATA_DIR=
# Standard profile only:
DATABASE_URL=
RABBITMQ_URL=
ARTIFACT_ROOT=
# Real AI stays fail-closed until this is changed to true and setup is approved.
AI_COMPANY_REAL_AI_ENABLED=false
# Role routing: primary handles the work; fallbacks are used only for retryable failures.
AI_COMPANY_STORY_ARCHITECT_PROVIDER=gemini
AI_COMPANY_STORY_ARCHITECT_FALLBACKS=
# Leave these blank to inherit the Story Architect route.
AI_COMPANY_CHAPTER_WRITER_PROVIDER=
AI_COMPANY_CHAPTER_WRITER_FALLBACKS=
AI_COMPANY_EDITOR_PROVIDER=
AI_COMPANY_EDITOR_FALLBACKS=
AI_COMPANY_CONTINUITY_QC_PROVIDER=
AI_COMPANY_CONTINUITY_QC_FALLBACKS=
# Secret values intentionally stay blank in this tracked example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
AI_COMPANY_POLICY_VERSION=story-agents-policy-v1
AI_COMPANY_ASSIGNMENT_VERSION=story-agents-models-v1
AI_COMPANY_BUDGET_VERSION=story-agents-budget-v1
# Minor currency units: 100 means USD 1.00 when currency is USD.
AI_COMPANY_DAILY_BUDGET_MINOR=100
AI_COMPANY_BUDGET_CURRENCY=USD
# Copy current per-million-token prices in minor units from the official provider pricing page.
AI_COMPANY_GEMINI_RATE_CARD_VERSION=gemini-3.8-flash-standard-2026-10-10
AI_COMPANY_GEMINI_INPUT_MINOR_PER_MILLION=75
AI_COMPANY_GEMINI_OUTPUT_MINOR_PER_MILLION=375
AI_COMPANY_GEMINI_MAX_OUTPUT_TOKENS=6000
AI_COMPANY_GEMINI_TIMEOUT_SECONDS=60
# OpenAI values are required only when openai is primary or fallback.
AI_COMPANY_OPENAI_RATE_CARD_VERSION=gpt-6.1-sol-standard-2026-10-10
AI_COMPANY_OPENAI_INPUT_MINOR_PER_MILLION=200
AI_COMPANY_OPENAI_OUTPUT_MINOR_PER_MILLION=1000
AI_COMPANY_OPENAI_MAX_OUTPUT_TOKENS=6000
AI_COMPANY_OPENAI_TIMEOUT_SECONDS=60

# Optional localhost-only MuMuAINovel bridge.
MUMUAINOVEL_BASE_URL=http://127.0.0.1:8800
MUMUAINOVEL_USERNAME=
MUMUAINOVEL_PASSWORD=
