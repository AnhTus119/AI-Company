# Set secrets only in your local .env file. Never commit real values.
AI_COMPANY_PROFILE=lite
AI_COMPANY_DATA_DIR=
# Standard profile only:
DATABASE_URL=
RABBITMQ_URL=
ARTIFACT_ROOT=
# Real AI stays fail-closed until this is changed to true and setup is approved.
AI_COMPANY_REAL_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
AI_COMPANY_POLICY_VERSION=gemini-prototype-policy-v1
AI_COMPANY_ASSIGNMENT_VERSION=gemini-prototype-models-v1
AI_COMPANY_BUDGET_VERSION=gemini-prototype-budget-v1
# Minor currency units: 100 means USD 1.00 when currency is USD.
AI_COMPANY_DAILY_BUDGET_MINOR=100
AI_COMPANY_BUDGET_CURRENCY=USD
# Copy current per-million-token prices in minor units from the official provider pricing page.
AI_COMPANY_GEMINI_RATE_CARD_VERSION=
AI_COMPANY_GEMINI_INPUT_MINOR_PER_MILLION=
AI_COMPANY_GEMINI_OUTPUT_MINOR_PER_MILLION=
AI_COMPANY_GEMINI_MAX_OUTPUT_TOKENS=6000
AI_COMPANY_GEMINI_TIMEOUT_SECONDS=60
